# Copy this file to `.env` in the project root and fill in real values.
#   cp .env.example .env
#
# backend/config.py loads these on startup and RAISES if any Shoonya or Upstox
# value is missing or still starts with "your_". Telegram is optional.
# (Note: vendor-code / IMEI / Zerodha are NOT used by this codebase.)

# ── Shoonya (order placement) — REQUIRED ─────────────────────────────
SHOONYA_USER_ID=
SHOONYA_PASSWORD=
SHOONYA_TOTP_SECRET=
SHOONYA_API_SECRET=

# ── Upstox (market data: spot, option chain, LTP) — REQUIRED ─────────
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=
UPSTOX_MOBILE_NUMBER=
UPSTOX_TOTP_SECRET=
UPSTOX_PIN=

# ── Telegram notifications — OPTIONAL ────────────────────────────────
# Both must be set to enable alerts; leave blank to disable silently.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
